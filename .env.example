# Copy this file to .env and set the key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 生图接口与文本接口使用不同域名或路径时单独填写；留空则复用 OPENAI_BASE_URL。
OPENAI_IMAGE_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# OpenAI-compatible endpoint 可优先尝试 chat_completions；完整支持 Responses API 时可改为 responses。
OPENAI_TEXT_API=chat_completions
