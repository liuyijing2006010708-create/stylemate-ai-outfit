# Copy this file to .env and set the key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 中转站生图接口与文本接口不同域名/路径时，单独填写；留空则复用 OPENAI_BASE_URL。
OPENAI_IMAGE_BASE_URL=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
# 中转站若不支持 Responses API，可改成 chat_completions。
OPENAI_TEXT_API=responses

# RightAPI 示例（使用时替换上面的 OPENAI_BASE_URL）：
# OPENAI_BASE_URL=https://rightapi.ai/codex/v1
